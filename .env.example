# Lead delivery. Telegram is the primary channel and is required.
# Token: @BotFather → /newbot
# chat_id: send the bot any message, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email copy of each lead. Optional: without these variables
# email delivery is simply skipped.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=ARQON <noreply@arqon.by>
CONTACT_EMAIL_TO=hello@arqon.by

# Cookie-free analytics (Umami / Plausible). Optional.
# Values are baked into the client bundle at build time: changing them
# requires rebuilding the image, not just restarting the container.
# The domain is added to CSP automatically from this variable.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=
