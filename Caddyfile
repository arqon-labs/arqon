{
	email admin@arqon.by
	servers {
		protocols h1 h2 h3
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 15s
			write 2m
			idle 2m
		}
	}
}

www.arqon.by {
	redir https://arqon.by{uri} permanent
}

arqon.by {
	encode zstd gzip

	# Заголовки безопасности задаются в next.config.ts — здесь только транспорт,
	# чтобы не было двух источников правды.
	header -Server

	request_body {
		max_size 1MB
	}

	@immutable path /_next/static/* /icon* /opengraph-image*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000 {
		# Caddy — край сети: IP с сокета. X-Forwarded-* Caddy и так не доверяет клиенту.
		# Если включите Cloudflare (оранжевое облако) — уберите -CF-Connecting-IP,
		# иначе лимит формы увидит IP Cloudflare, а не посетителя.
		header_up X-Real-IP {remote_host}
		header_up -CF-Connecting-IP

		transport http {
			dial_timeout 3s
			response_header_timeout 30s
			max_conns_per_host 100
		}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
