# Доставка заявок. Telegram — основной канал, обязателен.
# Токен: @BotFather → /newbot
# chat_id: напишите боту любое сообщение и откройте
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Копия заявки на почту. Необязательно: без этих переменных
# отправка письма просто пропускается.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=ARQON <noreply@arqon.by>
CONTACT_EMAIL_TO=hello@arqon.by

# Аналитика без cookie (Umami / Plausible). Необязательно.
# Значения попадают в клиентский бандл на этапе сборки: при изменении
# нужно пересобрать образ, а не только перезапустить контейнер.
# Домен автоматически добавляется в CSP из этой переменной.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=
